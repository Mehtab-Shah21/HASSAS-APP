# Admin-install / local-dev default: the backend runs on this same PC.
# An employee-only build should NOT set this — omitting it makes the app
# show the "Connect to your office server" first-run screen instead
# (ServerConfigGate), which is the whole point of Prompt 14's employee
# install flavor. See PROGRESS.md.
VITE_API_URL=http://localhost:8000
